{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$defs":{
    "version":{"const":"1.0.0"},
    "version110":{"const":"1.1.0"},
    "version120":{"const":"1.2.0"},
    "version130":{"const":"1.3.0"},
    "version140":{"const":"1.4.0"},
    "decimal":{"type":"string","pattern":"^(0|-?[1-9][0-9]*)$"},
    "uint":{"type":"string","pattern":"^(0|[1-9][0-9]*)$"},
    "manifestEntry":{"type":"object","additionalProperties":false,"required":["kind","path"],"properties":{"kind":{"enum":["spec_match","int128","enforcement_gate"]},"path":{"type":"string","minLength":1}}},
    "manifestEntry110":{"type":"object","additionalProperties":false,"required":["kind","path"],"properties":{"kind":{"enum":["spec_match","int128","enforcement_gate","otlp_signal"]},"path":{"type":"string","minLength":1}}},
    "manifestEntry130":{"type":"object","additionalProperties":false,"required":["kind","path"],"properties":{"kind":{"enum":["spec_match","int128","enforcement_gate","otlp_signal","sequence_completeness"]},"path":{"type":"string","minLength":1}}},
    "manifestEntry140":{"type":"object","additionalProperties":false,"required":["kind","path"],"properties":{"kind":{"enum":["spec_match","int128","enforcement_gate","otlp_signal","sequence_completeness","decision_wait","filter_store"]},"path":{"type":"string","minLength":1}}},
    "otlpPath":{"type":"string","pattern":"^\\.\\./otlp/[A-Za-z0-9][A-Za-z0-9._-]*\\.bin$"},
    "otlpEvent":{"type":"object","additionalProperties":false,"required":["id","kind","sequence_epoch","sequence_number","predecessors"],"properties":{"id":{"type":"string","minLength":1},"kind":{"type":"string","minLength":1},"sequence_epoch":{"$ref":"#/$defs/uint"},"sequence_number":{"$ref":"#/$defs/uint"},"predecessors":{"type":"array","items":{"type":"string","minLength":1}}}},
    "otlpCompleteness":{"type":"object","additionalProperties":false,"required":["source_handle","sequence_epoch","last_emitted","complete_through","acknowledged_filter_epoch","clock_domain_id","occurrence_ns","uncertainty_nanoseconds","activity"],"properties":{"source_handle":{"type":"string","minLength":1},"sequence_epoch":{"$ref":"#/$defs/uint"},"last_emitted":{"$ref":"#/$defs/uint"},"complete_through":{"$ref":"#/$defs/uint"},"acknowledged_filter_epoch":{"$ref":"#/$defs/uint"},"clock_domain_id":{"type":"string","minLength":1},"occurrence_ns":{"$ref":"#/$defs/uint"},"uncertainty_nanoseconds":{"$ref":"#/$defs/uint"},"activity":{"enum":["active","idle"]}}},
    "otlpVerdict":{"type":"object","additionalProperties":false,"required":["id","outcome"],"properties":{"id":{"type":"string","minLength":1},"outcome":{"enum":["satisfy","violate","inconclusive"]}}},
    "otlpFilter":{"type":"object","additionalProperties":false,"required":["epoch","specification_ids"],"properties":{"epoch":{"$ref":"#/$defs/uint"},"specification_ids":{"type":"array","items":{"type":"string","minLength":1}}}},
    "otlpDecisionSpec":{"type":"object","additionalProperties":false,"required":["id","action"],"properties":{"id":{"type":"string","minLength":1},"action":{"enum":["permit","deny","defer"]}}},
    "otlpDecision":{"type":"object","additionalProperties":false,"required":["request_id","action","specifications"],"properties":{"request_id":{"type":"string","minLength":1},"action":{"enum":["permit","deny","defer"]},"specifications":{"type":"array","items":{"$ref":"#/$defs/otlpDecisionSpec"}}}},
    "seqOptionalUint":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/uint"}]},
    "seqStart":{"type":"object","additionalProperties":false,"required":["clock_unix_ms","epoch","previous_epoch"],"properties":{"clock_unix_ms":{"$ref":"#/$defs/uint"},"epoch":{"$ref":"#/$defs/seqOptionalUint"},"previous_epoch":{"$ref":"#/$defs/seqOptionalUint"}}},
    "seqError":{"enum":["epoch-not-greater","sequence-overflow","filter-epoch-regressed"]},
    "seqSignal":{"type":"object","additionalProperties":false,"required":["sequence_epoch","last_emitted","complete_through","acknowledged_filter_epoch","activity","reported_at_ns","activity_since_ns","restates_previous"],"properties":{"sequence_epoch":{"$ref":"#/$defs/uint"},"last_emitted":{"$ref":"#/$defs/uint"},"complete_through":{"$ref":"#/$defs/uint"},"acknowledged_filter_epoch":{"$ref":"#/$defs/uint"},"activity":{"enum":["active","idle"]},"reported_at_ns":{"$ref":"#/$defs/uint"},"activity_since_ns":{"$ref":"#/$defs/uint"},"restates_previous":{"type":"boolean"}}},
    "seqRange":{"type":"object","additionalProperties":false,"required":["first","last","filter_epoch"],"properties":{"first":{"$ref":"#/$defs/uint"},"last":{"$ref":"#/$defs/uint"},"filter_epoch":{"$ref":"#/$defs/uint"}}},
    "seqReport":{"type":"object","additionalProperties":false,"required":["op","send","filtered","expect"],"properties":{"op":{"enum":["tick","shutdown"]},"send":{"type":"array","items":{"enum":["accepted","not_accepted"]}},"filtered":{"type":"array","items":{"$ref":"#/$defs/seqRange"}},"expect_error":{"$ref":"#/$defs/seqError"},"expect":{"type":"array","items":{"$ref":"#/$defs/seqSignal"}}}},
    "seqStep":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["op","expect"],"properties":{"op":{"const":"allocate"},"expect":{"type":"object","additionalProperties":false,"required":["epoch","number"],"properties":{"epoch":{"$ref":"#/$defs/uint"},"number":{"$ref":"#/$defs/uint"}}}}},
      {"type":"object","additionalProperties":false,"required":["op","expect_error"],"properties":{"op":{"const":"allocate"},"expect_error":{"$ref":"#/$defs/seqError"}}},
      {"type":"object","additionalProperties":false,"required":["op","epoch","number"],"properties":{"op":{"enum":["export_ok","export_fail"]},"epoch":{"$ref":"#/$defs/uint"},"number":{"$ref":"#/$defs/uint"}}},
      {"type":"object","additionalProperties":false,"required":["op","epoch","number","filter_epoch"],"properties":{"op":{"const":"filter_drop"},"epoch":{"$ref":"#/$defs/uint"},"number":{"$ref":"#/$defs/uint"},"filter_epoch":{"$ref":"#/$defs/uint"}}},
      {"type":"object","additionalProperties":false,"required":["op","epoch"],"properties":{"op":{"const":"set_filter_epoch"},"epoch":{"$ref":"#/$defs/seqOptionalUint"}}},
      {"type":"object","additionalProperties":false,"required":["op","unix_ms"],"properties":{"op":{"const":"clock"},"unix_ms":{"$ref":"#/$defs/uint"}}},
      {"type":"object","additionalProperties":false,"required":["op"],"properties":{"op":{"enum":["idle","active"]}}},
      {"$ref":"#/$defs/seqReport"},
      {"type":"object","additionalProperties":false,"required":["op","clock_unix_ms","epoch","previous_epoch"],"properties":{"op":{"const":"restart"},"clock_unix_ms":{"$ref":"#/$defs/uint"},"epoch":{"$ref":"#/$defs/seqOptionalUint"},"previous_epoch":{"oneOf":[{"type":"null"},{"const":"inherit"},{"$ref":"#/$defs/uint"}]},"expect_error":{"$ref":"#/$defs/seqError"}}}
    ]},
    "seqScenarioCase":{"type":"object","additionalProperties":false,"required":["id","start","steps"],"properties":{"id":{"type":"string","minLength":1},"start":{"$ref":"#/$defs/seqStart"},"steps":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/seqStep"}}}},
    "seqHex":{"type":"string","pattern":"^([0-9a-f]{2})*$"},
    "seqPartialCase":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["id","response_hex","rejected_spans"],"properties":{"id":{"type":"string","minLength":1},"response_hex":{"$ref":"#/$defs/seqHex"},"rejected_spans":{"$ref":"#/$defs/uint"}}},
      {"type":"object","additionalProperties":false,"required":["id","response_hex","undecodable"],"properties":{"id":{"type":"string","minLength":1},"response_hex":{"$ref":"#/$defs/seqHex"},"undecodable":{"const":true}}}
    ]},
    "optionalUint":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/uint"}]},
    "dwBeforeAsk":{"enum":[[],["deliver"]]},
    "dwOnWait":{"enum":[[],["deliver"],["expire"],["deliver","expire"]]},
    "dwGateCase":{"type":"object","additionalProperties":false,"required":["id","via","request_id","filter","event","local_deadline_ns","clock_reads_ns","answer","before_ask","on_wait","expected"],"properties":{"id":{"type":"string","minLength":1},"via":{"const":"gate"},"request_id":{"type":"string","minLength":1},"filter":{"type":"object","additionalProperties":false,"required":["epoch","specifications"],"properties":{"epoch":{"$ref":"#/$defs/uint"},"specifications":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/gateSpec"}}}},"event":{"type":"object","additionalProperties":false,"required":["kind"],"properties":{"kind":{"type":"string"}}},"local_deadline_ns":{"$ref":"#/$defs/optionalUint"},"clock_reads_ns":{"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/$defs/uint"}},"answer":{"$ref":"#/$defs/otlpPath"},"before_ask":{"$ref":"#/$defs/dwBeforeAsk"},"on_wait":{"$ref":"#/$defs/dwOnWait"},"expected":{"type":"object","additionalProperties":false,"required":["kind","decide_calls","remaining_transport_budget_ns","armed_wait_ns"],"properties":{"kind":{"enum":["permit","deny","fail-open-permit","fail-closed-deny"]},"decide_calls":{"const":1},"remaining_transport_budget_ns":{"$ref":"#/$defs/uint"},"armed_wait_ns":{"$ref":"#/$defs/optionalUint"}}}}},
    "dwAdapterCase":{"type":"object","additionalProperties":false,"required":["id","via","request_id","remaining_transport_budget_ns","answer","before_ask","on_wait","expected"],"properties":{"id":{"type":"string","minLength":1},"via":{"const":"adapter"},"request_id":{"type":"string","minLength":1},"remaining_transport_budget_ns":{"$ref":"#/$defs/optionalUint"},"answer":{"$ref":"#/$defs/otlpPath"},"before_ask":{"$ref":"#/$defs/dwBeforeAsk"},"on_wait":{"$ref":"#/$defs/dwOnWait"},"expected":{"type":"object","additionalProperties":false,"required":["result","armed_wait_ns"],"properties":{"result":{"enum":["permit","deny","error"]},"armed_wait_ns":{"$ref":"#/$defs/optionalUint"}}}}},
    "fsFilter":{"type":"object","additionalProperties":false,"required":["label","epoch"],"properties":{"label":{"type":"string","minLength":1},"epoch":{"$ref":"#/$defs/optionalUint"}}},
    "fsStep":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["op","filter","expected"],"properties":{"op":{"const":"set"},"filter":{"$ref":"#/$defs/fsFilter"},"expected":{"type":"object","additionalProperties":false,"required":["held"],"properties":{"applied":{"type":"boolean"},"held":{"$ref":"#/$defs/fsFilter"}}}}},
      {"type":"object","additionalProperties":false,"required":["op","epoch","expected"],"properties":{"op":{"const":"should_refresh"},"epoch":{"$ref":"#/$defs/optionalUint"},"expected":{"type":"boolean"}}}
    ]},
    "fsCase":{"type":"object","additionalProperties":false,"required":["id","initial","steps"],"properties":{"id":{"type":"string","minLength":1},"initial":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/fsFilter"}]},"steps":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/fsStep"}}}},
    "malformedEntry":{"type":"object","additionalProperties":false,"required":["path","rejection_category"],"properties":{"path":{"type":"string","minLength":1},"rejection_category":{"enum":["version","duplicate-key","unknown-field","unknown-token","missing-field","integer-lexeme","integer-range","duplicate-id"]}}},
    "eventMatch":{"type":"object","additionalProperties":false,"required":["event_kinds","delivery_mode","projected_attribute_keys"],"properties":{"event_kinds":{"type":"array","items":{"type":"string"}},"delivery_mode":{"enum":["ship_async","ask_and_block"]},"projected_attribute_keys":{"type":"array","items":{"type":"string"}}}},
    "specMatchCase":{"type":"object","additionalProperties":false,"required":["id","specification_filter","producer_event","expected"],"properties":{"id":{"type":"string","minLength":1},"specification_filter":{"type":"object","additionalProperties":false,"required":["event_match","fail_mode"],"properties":{"event_match":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/eventMatch"}]},"fail_mode":{"enum":["open","closed"]}}},"producer_event":{"type":"object","additionalProperties":false,"required":["kind"],"properties":{"kind":{"type":"string"}}},"expected":{"type":"boolean"}}},
    "int128Case":{"type":"object","additionalProperties":false,"required":["id","value","high","low"],"properties":{"id":{"type":"string","minLength":1},"value":{"$ref":"#/$defs/decimal"},"high":{"$ref":"#/$defs/decimal"},"low":{"$ref":"#/$defs/decimal"}}},
    "gateSpec":{"type":"object","additionalProperties":false,"required":["id","event_kinds","delivery_mode","evaluation_mode","readiness","latency_budget_ns","fail_mode","accepted_fail_mode"],"properties":{"id":{"type":"string","minLength":1},"event_kinds":{"type":"array","items":{"type":"string"}},"delivery_mode":{"enum":["ship_async","ask_and_block"]},"evaluation_mode":{"const":"enforce"},"readiness":{"const":"active"},"latency_budget_ns":{"$ref":"#/$defs/decimal"},"fail_mode":{"enum":["open","closed"]},"accepted_fail_mode":{"enum":["open","closed"]}}},
    "gateCase":{"type":"object","additionalProperties":false,"required":["id","filter","event","local_deadline_ns","clock_reads_ns","decider","expected"],"properties":{"id":{"type":"string","minLength":1},"filter":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["epoch","specifications"],"properties":{"epoch":{"$ref":"#/$defs/decimal"},"specifications":{"type":"array","items":{"$ref":"#/$defs/gateSpec"}}}}]},"event":{"type":"object","additionalProperties":false,"required":["kind"],"properties":{"kind":{"type":"string"}}},"local_deadline_ns":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/decimal"}]},"clock_reads_ns":{"type":"array","items":{"$ref":"#/$defs/decimal"}},"decider":{"type":"object","additionalProperties":false,"required":["result"],"properties":{"result":{"enum":["permit","deny","defer","unspecified","transport_error"]}}},"expected":{"type":"object","additionalProperties":false,"required":["kind","reason","decide_calls"],"properties":{"kind":{"enum":["no-filter","permit","deny","defer","fail-open-permit","fail-closed-deny"]},"reason":{"type":["string","null"]},"decide_calls":{"type":"integer","minimum":0},"remaining_transport_budget_ns":{"$ref":"#/$defs/decimal"}}}}}
  },
  "oneOf":[
    {"type":"object","additionalProperties":false,"required":["format_version","suites","malformed"],"properties":{"format_version":{"$ref":"#/$defs/version"},"suites":{"type":"array","items":{"$ref":"#/$defs/manifestEntry"}},"malformed":{"type":"array","items":{"$ref":"#/$defs/malformedEntry"}}}},
    {"type":"object","additionalProperties":false,"required":["format_version","suites","malformed"],"properties":{"format_version":{"$ref":"#/$defs/version110"},"suites":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/manifestEntry110"},"contains":{"type":"object","required":["kind"],"properties":{"kind":{"const":"otlp_signal"}}}},"malformed":{"type":"array","items":{"$ref":"#/$defs/malformedEntry"}}}},
    {"type":"object","additionalProperties":false,"required":["format_version","suites","malformed"],"properties":{"format_version":{"$ref":"#/$defs/version130"},"suites":{"type":"array","minItems":2,"items":{"$ref":"#/$defs/manifestEntry130"},"allOf":[{"contains":{"type":"object","required":["kind"],"properties":{"kind":{"const":"otlp_signal"}}}},{"contains":{"type":"object","required":["kind"],"properties":{"kind":{"const":"sequence_completeness"}}}}]},"malformed":{"type":"array","items":{"$ref":"#/$defs/malformedEntry"}}}},
    {"type":"object","additionalProperties":false,"required":["format_version","suites","malformed"],"properties":{"format_version":{"$ref":"#/$defs/version140"},"suites":{"type":"array","minItems":4,"items":{"$ref":"#/$defs/manifestEntry140"},"allOf":[{"contains":{"type":"object","required":["kind"],"properties":{"kind":{"const":"otlp_signal"}}}},{"contains":{"type":"object","required":["kind"],"properties":{"kind":{"const":"sequence_completeness"}}}},{"contains":{"type":"object","required":["kind"],"properties":{"kind":{"const":"decision_wait"}}}},{"contains":{"type":"object","required":["kind"],"properties":{"kind":{"const":"filter_store"}}}}]},"malformed":{"type":"array","items":{"$ref":"#/$defs/malformedEntry"}}}},
    {"type":"object","additionalProperties":false,"required":["format_version","kind","cases"],"properties":{"format_version":{"$ref":"#/$defs/version120"},"kind":{"const":"decision_wait"},"cases":{"type":"array","minItems":1,"items":{"oneOf":[{"$ref":"#/$defs/dwGateCase"},{"$ref":"#/$defs/dwAdapterCase"}]}}}},
    {"type":"object","additionalProperties":false,"required":["format_version","kind","cases"],"properties":{"format_version":{"$ref":"#/$defs/version120"},"kind":{"const":"filter_store"},"cases":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/fsCase"}}}},
    {"type":"object","additionalProperties":false,"required":["format_version","kind","cases"],"properties":{"format_version":{"$ref":"#/$defs/version130"},"kind":{"const":"sequence_completeness"},"cases":{"type":"array","minItems":1,"items":{"oneOf":[{"$ref":"#/$defs/seqScenarioCase"},{"$ref":"#/$defs/seqPartialCase"}]}}}},
    {"type":"object","additionalProperties":false,"required":["format_version","kind","cases"],"properties":{"format_version":{"$ref":"#/$defs/version110"},"kind":{"const":"otlp_signal"},"cases":{"type":"array","items":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["id","signal","path","events"],"properties":{"id":{"type":"string","minLength":1},"signal":{"const":"trace"},"path":{"$ref":"#/$defs/otlpPath"},"events":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/otlpEvent"}}}},
      {"type":"object","additionalProperties":false,"required":["id","signal","path","reject"],"properties":{"id":{"type":"string","minLength":1},"signal":{"const":"trace"},"path":{"$ref":"#/$defs/otlpPath"},"reject":{"const":true}}},
      {"type":"object","additionalProperties":false,"required":["id","signal","path","completeness"],"properties":{"id":{"type":"string","minLength":1},"signal":{"const":"completeness"},"path":{"$ref":"#/$defs/otlpPath"},"completeness":{"$ref":"#/$defs/otlpCompleteness"}}},
      {"type":"object","additionalProperties":false,"required":["id","signal","path","verdict"],"properties":{"id":{"type":"string","minLength":1},"signal":{"const":"verdict"},"path":{"$ref":"#/$defs/otlpPath"},"verdict":{"$ref":"#/$defs/otlpVerdict"}}},
      {"type":"object","additionalProperties":false,"required":["id","signal","path","event_filter"],"properties":{"id":{"type":"string","minLength":1},"signal":{"const":"event_filter"},"path":{"$ref":"#/$defs/otlpPath"},"event_filter":{"$ref":"#/$defs/otlpFilter"}}},
      {"type":"object","additionalProperties":false,"required":["id","signal","path","decide_response"],"properties":{"id":{"type":"string","minLength":1},"signal":{"const":"decide_response"},"path":{"$ref":"#/$defs/otlpPath"},"decide_response":{"$ref":"#/$defs/otlpDecision"}}}
    ]}}}},
    {"type":"object","additionalProperties":false,"required":["format_version","kind","cases"],"properties":{"format_version":{"$ref":"#/$defs/version"},"kind":{"const":"spec_match"},"cases":{"type":"array","items":{"$ref":"#/$defs/specMatchCase"}}}},
    {"type":"object","additionalProperties":false,"required":["format_version","kind","cases"],"properties":{"format_version":{"$ref":"#/$defs/version"},"kind":{"const":"int128"},"cases":{"type":"array","items":{"$ref":"#/$defs/int128Case"}}}},
    {"type":"object","additionalProperties":false,"required":["format_version","kind","cases"],"properties":{"format_version":{"$ref":"#/$defs/version"},"kind":{"const":"enforcement_gate"},"cases":{"type":"array","items":{"$ref":"#/$defs/gateCase"}}}}
  ]
}
