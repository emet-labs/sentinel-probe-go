{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$defs":{
    "version":{"const":"1.0.0"},
    "decimal":{"type":"string","pattern":"^(0|-?[1-9][0-9]*)$"},
    "manifestEntry":{"type":"object","additionalProperties":false,"required":["kind","path"],"properties":{"kind":{"enum":["spec_match","int128","enforcement_gate"]},"path":{"type":"string","minLength":1}}},
    "malformedEntry":{"type":"object","additionalProperties":false,"required":["path","rejection_category"],"properties":{"path":{"type":"string","minLength":1},"rejection_category":{"enum":["version","duplicate-key","unknown-field","unknown-token","missing-field","integer-lexeme","integer-range","duplicate-id"]}}},
    "eventMatch":{"type":"object","additionalProperties":false,"required":["event_kinds","delivery_mode","projected_attribute_keys"],"properties":{"event_kinds":{"type":"array","items":{"type":"string"}},"delivery_mode":{"enum":["ship_async","ask_and_block"]},"projected_attribute_keys":{"type":"array","items":{"type":"string"}}}},
    "specMatchCase":{"type":"object","additionalProperties":false,"required":["id","specification_filter","producer_event","expected"],"properties":{"id":{"type":"string","minLength":1},"specification_filter":{"type":"object","additionalProperties":false,"required":["event_match","fail_mode"],"properties":{"event_match":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/eventMatch"}]},"fail_mode":{"enum":["open","closed"]}}},"producer_event":{"type":"object","additionalProperties":false,"required":["kind"],"properties":{"kind":{"type":"string"}}},"expected":{"type":"boolean"}}},
    "int128Case":{"type":"object","additionalProperties":false,"required":["id","value","high","low"],"properties":{"id":{"type":"string","minLength":1},"value":{"$ref":"#/$defs/decimal"},"high":{"$ref":"#/$defs/decimal"},"low":{"$ref":"#/$defs/decimal"}}},
    "gateSpec":{"type":"object","additionalProperties":false,"required":["id","event_kinds","delivery_mode","evaluation_mode","readiness","latency_budget_ns","fail_mode","accepted_fail_mode"],"properties":{"id":{"type":"string","minLength":1},"event_kinds":{"type":"array","items":{"type":"string"}},"delivery_mode":{"enum":["ship_async","ask_and_block"]},"evaluation_mode":{"const":"enforce"},"readiness":{"const":"active"},"latency_budget_ns":{"$ref":"#/$defs/decimal"},"fail_mode":{"enum":["open","closed"]},"accepted_fail_mode":{"enum":["open","closed"]}}},
    "gateCase":{"type":"object","additionalProperties":false,"required":["id","filter","event","local_deadline_ns","clock_reads_ns","decider","expected"],"properties":{"id":{"type":"string","minLength":1},"filter":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["epoch","specifications"],"properties":{"epoch":{"$ref":"#/$defs/decimal"},"specifications":{"type":"array","items":{"$ref":"#/$defs/gateSpec"}}}}]},"event":{"type":"object","additionalProperties":false,"required":["kind"],"properties":{"kind":{"type":"string"}}},"local_deadline_ns":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/decimal"}]},"clock_reads_ns":{"type":"array","items":{"$ref":"#/$defs/decimal"}},"decider":{"type":"object","additionalProperties":false,"required":["result"],"properties":{"result":{"enum":["permit","deny","defer","unspecified","transport_error"]}}},"expected":{"type":"object","additionalProperties":false,"required":["kind","reason","decide_calls"],"properties":{"kind":{"enum":["no-filter","permit","deny","defer","fail-open-permit","fail-closed-deny"]},"reason":{"type":["string","null"]},"decide_calls":{"type":"integer","minimum":0},"remaining_transport_budget_ns":{"$ref":"#/$defs/decimal"}}}}}
  },
  "oneOf":[
    {"type":"object","additionalProperties":false,"required":["format_version","suites","malformed"],"properties":{"format_version":{"$ref":"#/$defs/version"},"suites":{"type":"array","items":{"$ref":"#/$defs/manifestEntry"}},"malformed":{"type":"array","items":{"$ref":"#/$defs/malformedEntry"}}}},
    {"type":"object","additionalProperties":false,"required":["format_version","kind","cases"],"properties":{"format_version":{"$ref":"#/$defs/version"},"kind":{"const":"spec_match"},"cases":{"type":"array","items":{"$ref":"#/$defs/specMatchCase"}}}},
    {"type":"object","additionalProperties":false,"required":["format_version","kind","cases"],"properties":{"format_version":{"$ref":"#/$defs/version"},"kind":{"const":"int128"},"cases":{"type":"array","items":{"$ref":"#/$defs/int128Case"}}}},
    {"type":"object","additionalProperties":false,"required":["format_version","kind","cases"],"properties":{"format_version":{"$ref":"#/$defs/version"},"kind":{"const":"enforcement_gate"},"cases":{"type":"array","items":{"$ref":"#/$defs/gateCase"}}}}
  ]
}
